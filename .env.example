# Copy this file to .env and fill in your own values. Never commit .env.
POSTGRES_USER=n8n
POSTGRES_PASSWORD=change-me
# Any long random string. Keep it: n8n needs it to decrypt saved credentials.
N8N_ENCRYPTION_KEY=change-me-to-a-long-random-string
# Public HTTPS URL that forwards to localhost:5678 (needed for the Telegram trigger)
WEBHOOK_URL=https://your-tunnel-url.example.com/
